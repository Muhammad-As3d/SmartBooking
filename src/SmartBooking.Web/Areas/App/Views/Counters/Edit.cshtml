@model CounterEditModel
@{
    ViewData["Title"] = Model.Id is null ? "نقطة خدمة جديدة" : "تعديل نقطة خدمة";
    var services = (List<Option>)ViewBag.Services;
}
<div class="panel narrow-left">
    <form asp-antiforgery="true" method="post" action="/app/counters/save" class="stack" novalidate>
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
        <div class="grid g2">
            <div class="field">
                <label asp-for="Name">الاسم</label>
                <input asp-for="Name" class="input" placeholder="عيادة د. سارة / شباك 2" />
                <span asp-validation-for="Name" class="field-validation-error"></span>
            </div>
            <div class="field">
                <label asp-for="SortOrder">الترتيب</label>
                <input asp-for="SortOrder" class="input ltr" type="number" min="0" />
            </div>
        </div>
        <div class="field">
            <label>الخدمات اللي بتقدمها</label>
            <div class="grid g2">
                @foreach (var s in services)
                {
                    <label class="check panel flat">
                        <input type="checkbox" name="ServiceIds" value="@s.Id" @(Model.ServiceIds.Contains(s.Id) ? "checked" : "") /> @s.Name
                    </label>
                }
            </div>
        </div>
        <label class="check"><input asp-for="IsActive" /> مفعّلة</label>
        <div class="row">
            <button class="btn primary" type="submit">حفظ</button>
            <a class="btn ghost" href="/app/counters">رجوع</a>
        </div>
    </form>
</div>
